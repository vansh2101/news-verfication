# Backend Environment Configuration

# ==========================================
# REQUIRED API KEYS
# ==========================================

# Gemini API Key (Required for AI analysis)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# SOCIAL MEDIA & NEWS API KEYS
# ==========================================

# YouTube API Key (Required for YouTube video search)
# Get your key at: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Reddit API Credentials (Required for Reddit discussions)
# Get credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=My Scraper v1.0 by u/YourUsername

# Twitter/X API Credentials (Optional for Twitter posts)
# Get credentials at: https://developer.twitter.com/
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here

# SerpAPI Key (Required for Google News search)
# Get your key at: https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_key_here
SERP_API_KEY=your_serpapi_key_here

# GNews API Key (Fallback for news extraction)
# Get your key at: https://gnews.io/
GNEWS_API_KEY=your_gnews_api_key_here

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================

# News API Key (Optional)
NEWSAPI_KEY=your_newsapi_key_here

# Frontend Origin (for CORS)
FRONTEND_ORIGIN=http://localhost:3000
